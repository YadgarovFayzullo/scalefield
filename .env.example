# Scalefield — control-plane и панель. Скопируй в .env (gitignored).

# Пароль входа в панель и секрет подписи cookie (openssl rand -hex 32).
DASHBOARD_PASSWORD=
SESSION_SECRET=
# Ключ шифрования секретов в базе (токены агентов, строки подключения).
# Отдельно от SESSION_SECRET: его ротация не должна ломать записи. В dev
# можно не задавать — возьмётся SESSION_SECRET.
ENCRYPTION_KEY=

# База control-plane (организации, проекты, серверы, сервисы, деплои).
# Миграции применяются на старте приложения (drizzle/), drizzle-kit в рантайме не нужен.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scalefield

# Relay — точка, к которой подключаются агенты серверов (relay/). Секрет общий
# для control-plane и relay (openssl rand -hex 32); RELAY_URL — внутренний адрес.
RELAY_URL=http://relay:3003
RELAY_SECRET=
# Адрес relay, как его видит сервер клиента (в скрипте установки агента),
# образ агента и email для Let's Encrypt (Traefik на сервере клиента).
RELAY_PUBLIC_URL=wss://relay.scalefield.uz/agent
AGENT_IMAGE=ghcr.io/yadgarovfayzullo/scalefield-agent:latest
ACME_EMAIL=

# Бутстрап первого проекта, когда база пустая: токен агента и репозитории
# сервисов. После первого запуска проекты живут в базе, env больше не читается.
# STATUS_API_URL нужен только переходному прямому режиму (агент в той же
# docker-сети); без него сервер ждёт агента через relay.
STATUS_API_URL=
STATUS_API_TOKEN=
GITHUB_REPOS=YadgarovFayzullo/researcher-uz,YadgarovFayzullo/researcher.uz-backend,YadgarovFayzullo/scalefield
BOOTSTRAP_ORG=scalefield
BOOTSTRAP_PROJECT_SLUG=researcher-uz
BOOTSTRAP_PROJECT_NAME=researcher.uz
BOOTSTRAP_SERVER_HOST=localhost
# База проекта для редактора таблиц (регистрируется в databases, если её ещё нет).
BOOTSTRAP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scientific_db

# Токен GitHub с правом actions:read — для синка деплоев из GitHub Actions.
GITHUB_TOKEN=
