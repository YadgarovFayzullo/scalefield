# Scalefield — панель владельца researcher.uz. Скопируй в .env (gitignored).

# Пароль входа в панель и секрет подписи cookie (openssl rand -hex 32).
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Статус-API (researcher-uz-status/api): адрес внутри docker-сети и общий токен.
STATUS_API_URL=http://status-api:8000
STATUS_API_TOKEN=

# История деплоев: репозитории через запятую и токен GitHub с правом actions:read.
GITHUB_REPOS=YadgarovFayzullo/researcher-uz,YadgarovFayzullo/researcher.uz-backend,YadgarovFayzullo/scalefield
GITHUB_TOKEN=
